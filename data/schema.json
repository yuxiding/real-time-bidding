{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aurora Bid Engine Data Schema",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "adslot_id": { "type": "string" },
    "request_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "device": { "type": "string" },
    "location": { "type": "string" },
    "media": { "type": "string" },
    "browser": { "type": "string" },
    "campaign_id": { "type": "string" },
    "bid_price": { "type": "number" },
    "ctr": { "type": "number" },
    "cvr": { "type": "number" },
    "value": { "type": "number" },
    "click": { "type": "boolean" },
    "conversion": { "type": "boolean" }
  },
  "required": [
    "user_id",
    "adslot_id",
    "request_id",
    "timestamp",
    "bid_price",
    "ctr",
    "cvr",
    "value"
  ]
}
